# Contracts — Environment Variables
# Copy this file to .env and fill in your values before deploying.

# Your deployer wallet private key (without 0x prefix)
# NEVER commit the real .env file — it is in .gitignore
PRIVATE_KEY=your_deployer_wallet_private_key_here

# Polygon Amoy RPC endpoint
# Free public endpoint (may be rate-limited):
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# Or use Alchemy/Infura:
# POLYGON_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY

# Polygonscan API key for contract source verification
# Get one at: https://polygonscan.com/apis
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

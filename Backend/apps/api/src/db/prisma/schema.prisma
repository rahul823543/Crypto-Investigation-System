generator client {
  provider = "prisma-client"
  output   = "../../generated"
}

datasource db {
  provider = "postgresql"
}

model Case {
  id           String        @id @default(cuid())
  rootAddress  String
  chainId      Int
  mode         String
  status       String        @default("created")
  riskScore    Int?
  riskLevel   String?
  errorMessage String?
  createdAt    DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  transactions Transaction[]
  graphNodes   GraphNode[]
  graphEdges   GraphEdge[]
  riskFindings RiskFinding[]
}

model Wallet {
  id        String   @id @default(cuid())
  address   String
  chainId   Int
  label     String?
  type      String?
  riskLevel String?
  createdAt DateTime @default(now())

  @@unique([address, chainId])
}

model Transaction {
  id             String   @id @default(cuid())
  caseId         String
  hash           String
  chainId        Int
  blockNumber    Int
  fromAddress    String
  toAddress      String
  asset          String
  tokenAddress   String?
  amount         String
  amountUsd      Float?
  timestamp      DateTime
  transferType   String
  method         String?
  rawProviderRef String?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@unique([caseId, hash, rawProviderRef])
}

model GraphNode {
  id          String      @id @default(cuid())
  caseId      String
  address     String
  type        String
  labelsJson  String
  riskLevel   String?
  totalInUsd  Float?
  totalOutUsd Float?
  createdAt   DateTime    @default(now())

  case          Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  outgoingEdges GraphEdge[] @relation("OutgoingEdges")
  incomingEdges GraphEdge[] @relation("IncomingEdges")

  @@unique([caseId, address])
}

model GraphEdge {
  id              String    @id @default(cuid())
  caseId          String
  fromNodeId      String
  toNodeId        String
  transactionHash String
  asset           String
  amount          String
  amountUsd       Float?
  timestamp       DateTime
  hopDepth        Int       @default(1)
  riskLevel       String?
  createdAt       DateTime  @default(now())

  case     Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromNode GraphNode @relation("OutgoingEdges", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode   GraphNode @relation("IncomingEdges", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@unique([caseId, transactionHash, fromNodeId, toNodeId])
}

model RiskFinding {
  id                 String   @id @default(cuid())
  caseId             String
  source             String
  type               String
  severity           String
  confidence         Float
  title              String
  description        String
  relatedNodeIdsJson String
  relatedEdgeIdsJson String
  signalsJson        String
  createdAt          DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.1.0",
    "prisma": "^7.10.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
